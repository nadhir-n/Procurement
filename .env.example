# Environment variables for the procurement_api function.
#
# These are NOT read from this file at runtime. Catalyst functions read their
# environment from the console:
#   Catalyst console → Functions → procurement_api → Configuration →
#   Environment Variables
#
# This file documents what the function expects, so a fresh deployment can be
# configured without reading the source. Copy it to .env.local and fill in the
# real values for your own reference — .env.local is gitignored.

# The canonical public origin of this deployment. Every absolute URL handed to
# a browser or an email is built from it — the Books OAuth redirect, the Books
# return URL, and the developer/vendor invite links. Defaults to
# https://procurement.cloudhub.lk. Set this FIRST when moving domains; it is
# deliberately not derived from the Host header, because a header an attacker
# controls must never decide where an OAuth code is sent.
APP_ORIGIN=

# Extra browser origins allowed to call this API, comma-separated. The built-in
# pattern already covers localhost and *.catalystserverless / *.zohostratus /
# *.zoho.com; a mapped custom domain is NOT covered and must be listed here.
# Defaults to https://procurement.cloudhub.lk.
ALLOWED_ORIGINS=

# REQUIRED for the Zoho Books integration. Without it the Books endpoints
# return 503 BOOKS_NOT_CONFIGURED and the rest of the app runs normally.
# Value comes from the Zoho API Console entry for the "POS & Procurement" client.
BOOKS_CLIENT_SECRET=

# Optional — defaults to the registered "POS & Procurement" client ID.
# Only set this if you point the deployment at a different OAuth client.
BOOKS_CLIENT_ID=

# Optional — must EXACTLY match an Authorized Redirect URI on the OAuth client.
# Defaults to this project's function route. Set it when deploying to a new
# domain (a production environment or a custom domain), because the default
# will still point at the old host.
BOOKS_REDIRECT_URI=

# Optional — where the user lands after the Books OAuth handshake completes.
BOOKS_RETURN_URL=

# Optional — Stratus is primary for attachments; this is the legacy File Store
# folder used only for downloading pre-Stratus attachments.
ATTACHMENTS_FOLDER_ID=

# Optional — "from" address on outbound mail.
MAIL_FROM=

# Optional — comma-separated. These accounts can manage developer-portal
# membership. Defaults to sulaiman@cloudpartners.biz.
SUPER_ADMIN_EMAILS=
