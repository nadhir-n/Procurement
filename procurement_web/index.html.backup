<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Content Security Policy. The app has no inline <script> blocks, so
       script-src stays strict ('unsafe-inline' is NOT granted) — only this
       origin and the Zoho CDN that serves the Catalyst web SDK may run code.
       style-src does allow inline, because generated markup sets style
       attributes (document scaling, template previews) and that is not
       removable without a build step.
       Note: frame-ancestors is ignored when CSP arrives via <meta>; the API
       sends X-Frame-Options/frame-ancestors on its own responses. -->
  <meta http-equiv="Content-Security-Policy" content="
    default-src 'self';
    script-src 'self' https://static.zohocdn.com;
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
    font-src 'self' https://fonts.gstatic.com;
    img-src 'self' data: blob:;
    connect-src 'self' https://procurement.cloudhub.lk https://*.catalystserverless.com https://*.zohostratus.com https://*.zohoportal.com https://*.zoho.com;
    frame-src 'self' https://accounts.zoho.com https://*.zoho.com;
    object-src 'none';
    base-uri 'self';
    form-action 'self'">
  <title>ProcureFlow — Procurement Platform</title>
  <link rel="icon" type="image/png" href="img/procureflow-logo.png">
  <meta name="description" content="Hotel group procure-to-pay: requisitions, approvals, RFQs, purchase orders, receiving, 3-way matching, budgets and payments across every property.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/app.css?v=53">
  <link rel="stylesheet" href="css/stitch-ui.css?v=53">
  <link rel="stylesheet" href="css/enterprise-ui.css?v=53">
  <script src="https://static.zohocdn.com/catalyst/sdk/js/4.6.1/catalystWebSDK.js"></script>
  <script src="/__catalyst/sdk/init.js"></script>
</head>
<body>

  <!-- Boot / loading -->
  <div id="boot-screen" class="screen open">
    <div class="loader-wrap">
      <div class="loader-brand">
        <div class="loader-mark">
          <span class="loader-mark-letters"><svg viewBox="1.4 -0.15 64 64" fill="none" aria-hidden="true"><path d="M14.8 24 V53.6 a4.7 4.7 0 0 0 9.4 0 V24 Z" fill="#1481ff"/><path d="M33.4 5.4 A18.6 18.6 0 0 0 14.8 24 H24.2 A9.2 9.2 0 0 1 33.4 14.8 Z" fill="#ff2d2e"/><path d="M14.8 24 A18.6 18.6 0 0 0 33.4 42.6 V33.2 A9.2 9.2 0 0 1 24.2 24 Z" fill="#ff9108"/><path d="M52 24 A18.6 18.6 0 0 1 33.4 42.6 V33.2 A9.2 9.2 0 0 0 42.6 24 Z" fill="#2898e4"/><path d="M46.5 10.9 A18.6 18.6 0 0 1 52 24 H42.6 A9.2 9.2 0 0 0 40 17.4 Z" fill="#43ad54"/><path d="M33.4 5.4 L46.5 10.9 L40 17.4 Z" fill="#ffc002"/></svg></span>
          <svg class="loader-ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="ring-track" cx="50" cy="50" r="44"/>
            <circle class="ring-prog" cx="50" cy="50" r="44"/>
          </svg>
        </div>
        <div class="loader-title">ProcureFlow</div>
        <div class="loader-subtitle">Smarter Procurement. Simplified</div>
      </div>
      <!-- Procure-to-pay flow. Steps light up as boot progresses, so the
           animation reports real state instead of decorating a wait. -->
      <div class="loader-flow" id="boot-flow">
        <div class="flow-node" data-step="0">
          <span class="flow-dot"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M19 8v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7Z"/><path d="M9 12h6M9 16h4"/></svg></span>
          <span class="flow-label">Request</span>
        </div>
        <div class="flow-link"><span></span></div>
        <div class="flow-node" data-step="1">
          <span class="flow-dot"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.3 7 12 12l8.7-5"/><path d="M12 12v9"/><path d="m3.3 7 8.7-4 8.7 4v10L12 21 3.3 17Z"/></svg></span>
          <span class="flow-label">Order</span>
        </div>
        <div class="flow-link"><span></span></div>
        <div class="flow-node" data-step="2">
          <span class="flow-dot"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7Z"/><circle cx="7" cy="18.5" r="1.8"/><circle cx="17.5" cy="18.5" r="1.8"/></svg></span>
          <span class="flow-label">Receive</span>
        </div>
        <div class="flow-link"><span></span></div>
        <div class="flow-node" data-step="3">
          <span class="flow-dot"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M2.5 10h19"/><path d="M6 14.5h3"/></svg></span>
          <span class="flow-label">Pay</span>
        </div>
      </div>
      <div class="loader-bar"><div class="loader-bar-fill" id="boot-bar"></div></div>
      <div class="loader-status" id="boot-status" role="status" aria-live="polite">Connecting to your workspace…</div>

      <!-- Failure state: replaces the spinner rather than stalling on it. -->
      <div class="loader-fail" id="boot-fail" hidden>
        <div class="loader-fail-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 8v5"/><circle cx="12" cy="16.5" r="1.1" fill="currentColor" stroke="none"/><path d="M10.3 3.8 1.9 18a2 2 0 0 0 1.7 3h16.8a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z"/></svg>
        </div>
        <div class="loader-fail-title" id="boot-fail-title">Can't reach ProcureFlow</div>
        <div class="loader-fail-msg" id="boot-fail-msg"></div>
        <div class="loader-fail-actions">
          <button class="btn btn-primary btn-sm" id="boot-retry">Try again</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Login -->
  <div id="login-screen" class="screen">
    <main class="access-shell" aria-labelledby="access-title">
      <section class="access-brief" aria-label="ProcureFlow platform overview">
        <div class="access-brand"><span class="access-brand-mark">PF</span><span>ProcureFlow</span><span class="access-brand-edition">Hotel operations</span></div>
        <div class="access-hero">
          <p class="access-eyebrow">PROCUREMENT, IN PERFECT FLOW</p>
          <h1>Every purchase,<br><em>beautifully</em> in control.</h1>
          <p class="access-copy">One calm command centre for the people, properties and decisions behind every guest experience.</p>
        </div>
        <div class="procurement-orbit" aria-label="Procure-to-pay workflow: request, approval, order, receipt and payment">
          <div class="orbit-halo orbit-halo-a"></div><div class="orbit-halo orbit-halo-b"></div>
          <div class="orbit-core"><span class="orbit-core-mark">PF</span><strong>Procure<br>to pay</strong><small>in one flow</small></div>
          <div class="orbit-card orbit-request"><span class="orbit-icon">↗</span><div><b>Request</b><small>PR-0284 raised</small></div><i></i></div>
          <div class="orbit-card orbit-approval"><span class="orbit-icon">✓</span><div><b>Approval</b><small>Finance cleared</small></div><i></i></div>
          <div class="orbit-card orbit-order"><span class="orbit-icon">⌁</span><div><b>Order</b><small>PO issued</small></div><i></i></div>
          <div class="orbit-card orbit-receipt"><span class="orbit-icon">□</span><div><b>Receive</b><small>3-way matched</small></div><i></i></div>
          <span class="orbit-pulse orbit-pulse-one"></span><span class="orbit-pulse orbit-pulse-two"></span>
        </div>
        <div class="access-signals" aria-label="Security controls">
          <div><span aria-hidden="true">01</span><strong>Invitation-only</strong><small>Access stays within your hotel group.</small></div>
          <div><span aria-hidden="true">02</span><strong>Role-bound</strong><small>Each decision reaches the right person.</small></div>
          <div><span aria-hidden="true">03</span><strong>Always traceable</strong><small>Every commitment has a clear history.</small></div>
        </div>
      </section>
      <section class="auth-card access-card">
        <div class="access-card-top"><span class="access-shield" aria-hidden="true">✦</span><span>Private workspace</span></div>
        <div class="access-card-copy"><p class="access-kicker">GOOD TO SEE YOU</p><h2 id="access-title">Step into your<br>procurement flow.</h2>
        <p class="sub">Sign in with the Zoho Account linked to your invitation. Your workspace is ready when you are.</p></div>
        <div id="catalyst-login-container" class="catalyst-login" aria-live="polite"></div>
        <button id="btn-login" class="btn btn-primary access-login-fallback" type="button" hidden>Reload secure sign-in</button>
        <button id="btn-demo-login" class="btn btn-outline" type="button" style="width:100%;margin-top:12px;border:1px dashed #0a7a5c;color:#0a7a5c;background:#f0faf8;">▶ Enter Demo Account — view inside without Zoho invite</button>
        <div style="text-align:center;font-size:11px;color:var(--ink-muted);margin-top:6px;">demo@procureflow.local / Demo123! &nbsp;·&nbsp; local preview</div>
        <button id="btn-use-different-account" class="access-text-action" type="button">Use a different Zoho Account</button>
        <div class="access-support"><strong>Need help signing in?</strong> Use the recovery option in Zoho sign-in, or ask your Procurement administrator for an invitation.</div>
        <div class="error-line" id="login-error" role="alert"></div>
      </section>
    </main>
  </div>

  <!-- Onboarding (first login, no workspace yet) -->
  <div id="onboarding-screen" class="screen" style="overflow-y:auto;align-items:flex-start;padding-top:40px;">
    <div class="auth-card onboard-card" style="max-width:680px;">
      <div class="brand-row">
        <div class="brand-mark"><svg viewBox="1.4 -0.15 64 64" fill="none" aria-hidden="true"><path d="M14.8 24 V53.6 a4.7 4.7 0 0 0 9.4 0 V24 Z" fill="#1481ff"/><path d="M33.4 5.4 A18.6 18.6 0 0 0 14.8 24 H24.2 A9.2 9.2 0 0 1 33.4 14.8 Z" fill="#ff2d2e"/><path d="M14.8 24 A18.6 18.6 0 0 0 33.4 42.6 V33.2 A9.2 9.2 0 0 1 24.2 24 Z" fill="#ff9108"/><path d="M52 24 A18.6 18.6 0 0 1 33.4 42.6 V33.2 A9.2 9.2 0 0 0 42.6 24 Z" fill="#2898e4"/><path d="M46.5 10.9 A18.6 18.6 0 0 1 52 24 H42.6 A9.2 9.2 0 0 0 40 17.4 Z" fill="#43ad54"/><path d="M33.4 5.4 L46.5 10.9 L40 17.4 Z" fill="#ffc002"/></svg></div>
        <div style="text-align:left;">
          <div style="font-weight:800;font-size:16px;">ProcureFlow</div>
          <div style="font-size:11px;color:var(--ink-muted);">Smarter Procurement. Simplified</div>
        </div>
      </div>
      <h1>Set up your hotel group</h1>
      <p class="sub">This runs once. Departments, purchasing categories, CapEx/OpEx rules and hotel custom fields are configured for you — tell us the group details and which properties you run. Everything is editable later in Settings.</p>
      <form id="onboarding-form">
        <div class="nav-group-label" style="color:var(--ink-muted);padding:0 0 8px;">Group details</div>
        <div class="form-grid">
          <div class="field full">
            <label>Hotel or group name <span class="req">*</span></label>
            <input type="text" id="ob-org-name" required placeholder="e.g. Serendib Hotels &amp; Resorts">
          </div>
          <div class="field">
            <label>Company phone</label>
            <input type="tel" id="ob-phone" placeholder="+94 77 123 4567">
          </div>
          <div class="field full">
            <label>Business address</label>
            <input type="text" id="ob-address" placeholder="Street, city, postal code">
          </div>
        </div>
        <div style="background:var(--primary-soft);border:1px solid var(--border);border-radius:8px;padding:11px 14px;margin-top:12px;font-size:12.5px;line-height:1.5;color:var(--ink-2);">
          🏨 <strong>Hotel procurement</strong> — your workspace is created with the full departmental classification (10 departments, 27 purchasing categories, 137 sub-categories), the four expenditure classes (CapEx, OpEx, Repair, AMC), the approval hierarchy, standard payment terms and the item-master fields for UOM conversion, lead time, tax treatment and par levels.
        </div>

        <div class="nav-group-label" style="color:var(--ink-muted);padding:18px 0 8px;">Your properties</div>
        <div class="form-grid">
          <div class="field full">
            <label>Properties</label>
            <textarea id="ob-properties" rows="5" placeholder="Galle Face Hotel Colombo | Colombo | Galle Face Hotel&#10;Queens Hotel Kandy | Kandy | Kandy hotels&#10;EKHO Surf | Bentota | United Hotels"></textarea>
            <div class="help">One property per line, as <code>Name | Location | Cluster</code>. Location and cluster are optional, but grouping properties into clusters is what makes the group dashboard roll up. Leave this empty to start from the standard group structure. You can change any of it later in Settings → Properties.</div>
          </div>
        </div>

        <div class="nav-group-label" style="color:var(--ink-muted);padding:18px 0 8px;">Regional settings</div>
        <div class="form-grid">
          <div class="field">
            <label>Country</label>
            <select id="ob-country">
              <option value="">Select country…</option>
              <option>Sri Lanka</option><option>India</option><option>United States</option>
              <option>United Kingdom</option><option>United Arab Emirates</option><option>Singapore</option>
              <option>Australia</option><option>Canada</option><option>Germany</option><option>Other</option>
            </select>
          </div>
          <div class="field">
            <label>Base currency <span class="req">*</span></label>
            <select id="ob-currency">
              <option value="USD" selected>USD — US Dollar</option>
              <option value="LKR">LKR — Sri Lankan Rupee</option>
              <option value="INR">INR — Indian Rupee</option>
              <option value="EUR">EUR — Euro</option>
              <option value="GBP">GBP — British Pound</option>
              <option value="AED">AED — UAE Dirham</option>
              <option value="SGD">SGD — Singapore Dollar</option>
              <option value="AUD">AUD — Australian Dollar</option>
              <option value="CAD">CAD — Canadian Dollar</option>
            </select>
            <div class="help">All amounts across the app display in this currency.</div>
          </div>
          <div class="field">
            <label>Fiscal year starts in</label>
            <select id="ob-fiscal">
              <option selected>January</option><option>February</option><option>March</option>
              <option>April</option><option>May</option><option>June</option><option>July</option>
              <option>August</option><option>September</option><option>October</option>
              <option>November</option><option>December</option>
            </select>
          </div>
          <div class="field">
            <label>Time zone</label>
            <select id="ob-timezone">
              <option value="">Auto-detect</option>
              <option>Asia/Colombo</option><option>Asia/Kolkata</option><option>Asia/Dubai</option>
              <option>Asia/Singapore</option><option>Europe/London</option><option>Europe/Berlin</option>
              <option>America/New_York</option><option>America/Los_Angeles</option><option>Australia/Sydney</option>
            </select>
          </div>
        </div>

        <div class="nav-group-label" style="color:var(--ink-muted);padding:18px 0 8px;">About you</div>
        <div class="form-grid">
          <div class="field">
            <label>Your name</label>
            <input type="text" id="ob-admin-name" placeholder="Full name">
          </div>
          <div class="field">
            <label>Your approval limit</label>
            <input type="number" id="ob-approval-limit" value="50000" min="0" step="100">
            <div class="help">Requisitions above this amount route for approval.</div>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;margin-top:22px;padding:11px;">Create workspace</button>
        <div class="error-line" id="ob-error"></div>
      </form>
    </div>
  </div>

  <!-- Pending verification / suspended block -->
  <div id="blocked-screen" class="screen">
    <div class="auth-card">
      <div class="brand-row">
        <div class="brand-mark"><svg viewBox="1.4 -0.15 64 64" fill="none" aria-hidden="true"><path d="M14.8 24 V53.6 a4.7 4.7 0 0 0 9.4 0 V24 Z" fill="#1481ff"/><path d="M33.4 5.4 A18.6 18.6 0 0 0 14.8 24 H24.2 A9.2 9.2 0 0 1 33.4 14.8 Z" fill="#ff2d2e"/><path d="M14.8 24 A18.6 18.6 0 0 0 33.4 42.6 V33.2 A9.2 9.2 0 0 1 24.2 24 Z" fill="#ff9108"/><path d="M52 24 A18.6 18.6 0 0 1 33.4 42.6 V33.2 A9.2 9.2 0 0 0 42.6 24 Z" fill="#2898e4"/><path d="M46.5 10.9 A18.6 18.6 0 0 1 52 24 H42.6 A9.2 9.2 0 0 0 40 17.4 Z" fill="#43ad54"/><path d="M33.4 5.4 L46.5 10.9 L40 17.4 Z" fill="#ffc002"/></svg></div>
        <div style="text-align:left;">
          <div style="font-weight:800;font-size:16px;">ProcureFlow</div>
          <div style="font-size:11px;color:var(--ink-muted);">Smarter Procurement. Simplified</div>
        </div>
      </div>
      <div id="blocked-icon" style="font-size:40px;margin-bottom:6px;">🕒</div>
      <h1 id="blocked-title">Account under review</h1>
      <p class="sub" id="blocked-message">Your organization has been created and is awaiting verification by our team. You'll get full access as soon as it's approved — this usually doesn't take long.</p>
      <div id="blocked-org" style="background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:12px 16px;margin-bottom:16px;text-align:left;font-size:13px;"></div>
      <button id="btn-blocked-refresh" class="btn btn-primary" style="width:100%;margin-bottom:8px;">Check status again</button>
      <button id="btn-blocked-signout" class="btn btn-ghost" style="width:100%;">Sign out</button>
    </div>
  </div>

  <!-- App shell -->
  <div id="app">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <div class="brand-mark"><img class="brand-logo" src="img/procureflow-logo.png" alt="ProcureFlow logo"></div>
        <div>
          <div class="brand-name">ProcureFlow</div>
          <div class="brand-env">Smarter Procurement. Simplified</div>
        </div>
      </div>
      <nav id="side-nav"></nav>
      <div class="sidebar-footer">© ProcureFlow · <span id="build-version">…</span></div>
    </aside>
    <div class="sidebar-scrim" id="sidebar-scrim" aria-hidden="true"></div>

    <div class="main">
      <header class="topbar">
        <button class="hamburger" id="btn-hamburger" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="topbar-context">
          <div class="topbar-title" id="page-title">Dashboard</div>
        </div>
        <div class="global-search" role="search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
          <input id="global-search" type="search" autocomplete="off" placeholder="Search modules and workspaces" aria-label="Search modules and workspaces">
          <kbd>⌘ K</kbd>
          <div class="global-search-results" id="global-search-results" hidden></div>
        </div>
        <div class="topbar-right">
          <div class="org-chip" id="org-chip"><span class="dot"></span><span id="org-chip-name">—</span></div>
          <div class="quick-new">
            <button class="quick-new-btn" id="btn-quick-new" title="Create new" aria-label="Create new">＋</button>
            <div class="quick-new-menu" id="quick-new-menu">
              <a href="#/requisitions?new=1">📝 Purchase Request</a>
              <a href="#/vendors?new=1">🤝 Vendor</a>
              <a href="#/items?new=1">🏷️ Item</a>
            </div>
          </div>
          <button class="topbar-icon-btn" id="btn-notifications" title="Notifications" aria-label="Notifications">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
          </button>
          <a class="topbar-icon-btn" href="#/settings" title="All Settings" aria-label="Settings">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </a>
          <button class="avatar-btn" id="btn-avatar">?</button>
        </div>
        <div class="profile-menu" id="profile-menu">
          <div class="profile-menu-header">
            <div class="name" id="pm-name">—</div>
            <div class="email" id="pm-email">—</div>
          </div>
          <button class="menu-link" id="btn-theme">🌙 <span id="theme-label">Dark mode</span></button>
          <button class="menu-link" id="btn-tour">🧭 Take a product tour</button>
          <button class="menu-link danger" id="btn-signout">↪ Sign out</button>
        </div>
      </header>
      <main class="content"><div class="content-inner" id="view"></div></main>
    </div>
  </div>

  <!-- Full-page form root (Zoho-style form screens) -->
  <div id="page-root"></div>

  <!-- Modal root -->
  <div class="modal-backdrop" id="modal-backdrop">
    <div class="modal" id="modal">
      <div class="modal-header">
        <div class="modal-title" id="modal-title">—</div>
        <button class="modal-close" id="modal-close" aria-label="Close">×</button>
      </div>
      <div class="modal-body" id="modal-body"></div>
      <div class="modal-footer" id="modal-footer"></div>
    </div>
  </div>

  <div id="toast-container"></div>

  <script type="module" src="js/main.js?v=53"></script>
</body>
</html>
